{
  "name": "horipet",
  "version": "0.1.0",
  "description": "A little companion for your desktop. Original, offline-first desktop cat for macOS and Windows.",
  "main": "out/main/index.js",
  "type": "module",
  "author": "HoriPet contributors",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm typecheck && electron-vite build",
    "check": "pnpm test && pnpm build",
    "test:desktop": "pnpm build && node scripts/desktop-smoke.mjs",
    "test:packaged": "node scripts/desktop-smoke.mjs",
    "icons": "node scripts/create-icons.mjs",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --x64 --publish never",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "pnpm build && electron-builder --mac --x64 --publish never",
    "dist:win": "pnpm build && electron-builder --win --x64 --arm64 --publish never",
    "dist:win:x64": "pnpm build && electron-builder --win --x64 --publish never",
    "dist:win:arm64": "pnpm build && electron-builder --win --arm64 --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
