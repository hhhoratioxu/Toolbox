# Generate a URL-safe random password, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_PASSWORD
PUBLIC_URL=https://memory.example.com
MEMORY_DOMAIN=memory.example.com
ACME_EMAIL=admin@example.com
COOKIE_SECURE=true
# Model inference is optional and independent of the memory service.
# Use an address reachable from the container. Do not expose Ollama to the public internet.
MODEL_BASE_URL=
GENERATION_MODEL=
EMBEDDING_MODEL=
MODEL_EXTERNAL=false
