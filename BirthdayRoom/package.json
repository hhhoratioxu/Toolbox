{
  "name": "birthday-room",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/Toolbox/BirthdayRoom/",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "tsc -b && vite build && playwright test",
    "test:e2e:ui": "tsc -b && vite build && playwright test --ui"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "description": "A warm, fully interactive 3D birthday treasure hunt built with React and Three.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hhhoratioxu/Toolbox.git",
    "directory": "BirthdayRoom"
  },
  "bugs": {
    "url": "https://github.com/hhhoratioxu/Toolbox/issues"
  }
}
